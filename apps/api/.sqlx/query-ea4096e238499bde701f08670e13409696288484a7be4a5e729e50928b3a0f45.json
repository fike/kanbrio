  "query": "\n        SELECT\n            u.id,\n            u.name,\n            wm.role\n        FROM workspace_members wm\n        INNER JOIN users u ON u.id = wm.user_id\n        WHERE wm.workspace_id = $1\n        ORDER BY u.name ASC\n        ",
